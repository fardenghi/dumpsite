# Sin esta variable la web usa los datos de ejemplo de src/data/seed.
# VITE_API_URL=http://localhost:8000

# Opcional: clave de Google Maps Platform con la "Map Tiles API" habilitada. Activa la vista de
# alta resolución al abrir un basural. Sin ella el mapa usa sólo Sentinel-2.
# Restringirla por referrer HTTP y a esa API: queda visible en el navegador.
# VITE_GOOGLE_MAPS_KEY=
